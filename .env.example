# Copy to .env (git-ignored) and fill in on the SERVER only. Never commit real values.

# --- Optional: AI companion ---
ANTHROPIC_API_KEY=
CALM_COMPANION_MODEL=

# --- Storage ---
CALM_DB_PATH=

# --- Public URL (used for OAuth redirect URIs instead of the request Host header) ---
CALM_PUBLIC_URL=https://calm.example.com

# --- Encryption key for provider OAuth tokens at rest (32 random bytes, base64) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALM_TOKEN_KEY=

# --- Oura OAuth app (https://cloud.ouraring.com/oauth/applications) ---
# Redirect URI to register: ${CALM_PUBLIC_URL}/api/integrations/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# --- Web Push (VAPID). Generate with: npm run push:keys ---
CALM_VAPID_PUBLIC_KEY=
CALM_VAPID_PRIVATE_KEY=
CALM_VAPID_SUBJECT=mailto:you@your-domain

# --- Reverse proxy / cookies ---
CALM_TRUST_PROXY=
CALM_INSECURE_COOKIES=
