{
  "name": "calm-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Calm AI — personal wellbeing intelligence prototype",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "claim-legacy": "tsx scripts/claim-legacy.ts",
    "e2e": "node e2e/ui.e2e.cjs",
    "test:tz": "for z in UTC Africa/Cairo America/Los_Angeles Pacific/Kiritimati; do echo \"== TZ=$z\"; TZ=$z npm test --silent >/dev/null 2>&1 && echo pass || { echo FAIL; exit 1; }; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
